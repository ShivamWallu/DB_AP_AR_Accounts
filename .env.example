# AWS Deployment Environment Configuration
PORT=8000
HOST=0.0.0.0

# Database: Use PostgreSQL for AWS RDS, or SQLite for single-instance EC2
# Example AWS RDS URL: postgresql://username:password@your-rds-endpoint.amazonaws.com:5432/excel_db
DATABASE_URL=sqlite:///excel_system.db

# JWT Secret Key (Generate a random 64-char string for production)
SECRET_KEY=production-secure-jwt-secret-key-shivam-ai-2026-aws
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Initial Credentials
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=Admin@123
EMPLOYEE_DEFAULT_USER=employee
EMPLOYEE_DEFAULT_PASSWORD=Employee@123
